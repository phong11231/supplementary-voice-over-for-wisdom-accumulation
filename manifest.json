{
  "manifest_version": 3,
  "name": "Hoc Toolkit (Drive + Playlist)",
  "version": "2.0",
  "description": "Tai video/SRT tu Google Drive; tao muc luc tu playlist YouTube vao web hoc dang dang nhap; nap SRT hang loat theo ten page_X_page_Y.",
  "key": "",
  "permissions": ["storage", "unlimitedStorage", "identity", "scripting", "tabs"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://studio.youtube.com/*",
    "https://phong11231.github.io/*"
  ],
  "oauth2": {
    "client_id": "909922477358-lu6bdsfd4c8pcuvnmrfc981gg6puan4q.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.readonly"]
  },
  "content_scripts": [
    {
      "matches": ["https://studio.youtube.com/*"],
      "js": ["studio-panel.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["yt-dub.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Hoc Toolkit"
  }
}
